{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "before 9am every weekday"
  ],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "separateMajorMinor": false,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "minimumReleaseAge": "14 days",
      "groupName": "python dependencies"
    },
    {
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "minimumReleaseAge": "14 days",
      "groupName": "python dev dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major-update"
      ]
    }
  ]
}
