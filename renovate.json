{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "* 6-11 * * 1"
  ],
  "updateNotScheduled": false,
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "prCreation": "immediate",
  "prHourlyLimit": 1,
  "prConcurrentLimit": 2,
  "separateMajorMinor": true,
  "automerge": false,
  "packageRules": [
    {
      "matchDatasources": [
        "pypi"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin"
      ],
      "groupName": "python dependencies",
      "matchPackageNames": [
        "!python"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": "7 days",
      "groupName": "github actions"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": "7 days",
      "groupName": "container images"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "major-update"
      ]
    }
  ]
}
