{
  "execution_mode": "ci",
  "platform": "github",
  "base_branch": "main",
  "branch_prefix": "zeroone-ops",
  "dry_run": false,
  "apply_patch_in_dry_run": false,
  "openai_solution_output_path": "artifacts/openai-solution.json",
  "write_solution_artifacts_in_ci": false,
  "mock_llm_analysis_path": "fixtures/llm/analysis.json",
  "mock_llm_edit_path": "fixtures/llm/edit.json",
  "validation_setup_commands": [
    "uv sync --all-groups --locked"
  ],
  "validation_commands": [
    "uv run ruff check .",
    "uv run ruff format --check .",
    "uv run mypy src"
  ],
  "approval": {
    "required": true
  },
  "review": {
    "max_changed_files": 70,
    "max_findings_per_review": 5,
    "max_prior_review_passes": 5,
    "max_context_lines_before": 400,
    "max_context_lines_after": 400,
    "supported_paths": ["src/", "tests/", "app/"],
    "ignored_paths": ["src/generated/"],
    "skip_draft_merge_requests": true,
    "max_review_feedback_retries": 1,
    "inline_comments_enabled": true
  },
  "remediation": {
    "target_branch": "main",
    "bootstrap_severities": ["LOW"],
    "max_retry_count": 1,
    "validation_feedback_enabled": false,
    "analysis": {
      "context_lines_before": 40,
      "context_lines_after": 40,
      "max_file_bytes": 200000
    }
  },
  "sonarqube": {
    "mock_issues_path": "fixtures/sonar/issues.json"
  },
  "sarif": {
    "artifacts": [
      {
        "path": "artifacts/ruff.sarif",
        "source_id": "ruff-sarif"
      }
    ]
  },
  "github": {
    "labels": ["zeroone-ops", "zeroone-remediation"],
    "pull_request_assignee_username": "JustinMelger"
  },
  "state": {
    "path": ".zeroone-ops-state.json"
  }
}
