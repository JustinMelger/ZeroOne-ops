SONARQUBE_URL=https://sonarqube.example.com
SONARQUBE_TOKEN=replace-me
SONARQUBE_PROJECT_KEY=replace-me
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=replace-me
GITLAB_PROJECT_ID=replace-me
LLM_API_KEY=replace-me
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
AI_SONAR_BOT_CONFIG=.ai-sonar-bot.json
AI_SONAR_BOT_EXECUTION_MODE=ci
AI_SONAR_BOT_APPLY_PATCH_IN_DRY_RUN=false
AI_SONAR_BOT_OPENAI_SOLUTION_OUTPUT_PATH=artifacts/openai-solution.json
AI_SONAR_BOT_MOCK_LLM_ANALYSIS_PATH=fixtures/llm/analysis.json
AI_SONAR_BOT_MOCK_LLM_EDIT_PATH=fixtures/llm/edit.json
AI_SONAR_BOT_MOCK_SONAR_ISSUES_PATH=fixtures/sonar/issues.json
AI_SONAR_BOT_STATE_PATH=.ai-sonar-bot-state.json
AI_SONAR_BOT_LOG_LEVEL=INFO
