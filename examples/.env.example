# Choose the variables for the active platform and configured finding sources.

# GitLab
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=replace-me
GITLAB_PROJECT_ID=replace-me

# GitHub
GITHUB_TOKEN=replace-me
GITHUB_REPOSITORY=owner/repository

# SonarQube, when the GitLab or GitHub config enables SonarQube intake.
SONARQUBE_URL=https://sonarqube.example.com
SONARQUBE_TOKEN=replace-me
SONARQUBE_PROJECT_KEY=replace-me

# Shared LLM settings.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
# Optional MLflow tracing for OpenAI-backed runs.
# ZEROONE_MLFLOW_ENABLED=true
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=zeroone-ops-review
# MLFLOW_HTTP_REQUEST_TIMEOUT=5
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=1
# Use .zeroone-ops.json for the GitLab example or
# .zeroone-ops.github.json for the GitHub example.
ZEROONE_OPS_CONFIG=.zeroone-ops.json
ZEROONE_OPS_EXECUTION_MODE=ci
ZEROONE_OPS_APPLY_PATCH_IN_DRY_RUN=false
ZEROONE_OPS_OPENAI_SOLUTION_OUTPUT_PATH=artifacts/openai-solution.json
ZEROONE_OPS_WRITE_SOLUTION_ARTIFACTS_IN_CI=false
ZEROONE_OPS_MOCK_LLM_ANALYSIS_PATH=fixtures/llm/analysis.json
ZEROONE_OPS_MOCK_LLM_EDIT_PATH=fixtures/llm/edit.json
ZEROONE_OPS_MOCK_SONAR_ISSUES_PATH=fixtures/sonar/issues.json
ZEROONE_OPS_STATE_PATH=.zeroone-ops-state.json
