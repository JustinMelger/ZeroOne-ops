{
  "execution_mode": "ci",
  "base_branch": "main",
  "branch_prefix": "zeroone-ops",
  "dry_run": false,
  "apply_patch_in_dry_run": false,
  "openai_solution_output_path": "artifacts/openai-solution.json",
  "write_solution_artifacts_in_ci": false,
  "mock_llm_analysis_path": "fixtures/llm/analysis.json",
  "mock_llm_edit_path": "fixtures/llm/edit.json",
  "approval": {
    "required": true
  },
  "review": {
    "max_changed_files": 5,
    "max_findings_per_review": 3,
    "max_prior_review_passes": 2,
    "max_context_lines_before": 30,
    "max_context_lines_after": 30,
    "inline_comments_enabled": false,
    "_comment_supported_paths": "Optional allowlist. If omitted or empty, review considers all non-ignored changed paths.",
    "supported_paths": ["src/", "app/"],
    "ignored_paths": ["src/generated/"],
    "skip_draft_merge_requests": true,
    "max_review_feedback_retries": 1
  },
  "remediation": {
    "bootstrap_severities": ["LOW"],
    "max_retry_count": 1,
    "analysis": {
      "context_lines_before": 40,
      "context_lines_after": 40,
      "max_file_bytes": 200000
    }
  },
  "sonarqube": {
    "mock_issues_path": "fixtures/sonar/issues.json"
  },
  "gitlab": {
    "target_branch": "main",
    "labels": ["zeroone-ops", "sonarqube"],
    "_comment_merge_request_assignee_username": "Optional GitLab username to assign remediation merge requests to.",
    "merge_request_assignee_username": "justin"
  },
  "state": {
    "path": ".zeroone-ops-state.json"
  }
}
