{
  "execution_mode": "ci",
  "platform": "gitlab",
  "base_branch": "main",
  "branch_prefix": "zeroone-ops",
  "dry_run": false,
  "apply_patch_in_dry_run": false,
  "openai_solution_output_path": "artifacts/openai-solution.json",
  "write_solution_artifacts_in_ci": false,
  "approval": {
    "required": true
  },
  "review": {
    "max_changed_files": 5,
    "max_findings_per_review": 3,
    "max_prior_review_passes": 2,
    "inline_comments_enabled": false,
    "supported_paths": ["src/", "app/"],
    "ignored_paths": ["src/generated/"]
  },
  "remediation": {
    "target_branch": "main",
    "validation_setup_commands": [
      "uv sync --all-groups --locked"
    ],
    "validation_commands": [
      "uv run ruff check .",
      "uv run ruff format --check .",
      "uv run mypy src"
    ],
    "max_active_work_items": 10,
    "source_priorities": {
      "sonarqube": 10,
      "semgrep-sarif": 20,
      "ruff-sarif": 100,
      "mypy-sarif": 100
    },
    "bootstrap_severities": ["LOW"],
    "max_retry_count": 1,
    "validation_feedback_enabled": false,
    "analysis": {
      "max_file_bytes": 200000
    }
  },
  "gitlab": {
    "control_plane_mode": "issues",
    "labels": ["zeroone-ops", "sonarqube"]
  },
  "state": {
    "path": ".zeroone-ops-state.json"
  }
}
