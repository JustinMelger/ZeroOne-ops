{
  "execution_mode": "ci",
  "base_branch": "main",
  "branch_prefix": "ai-sonar",
  "dry_run": false,
  "apply_patch_in_dry_run": false,
  "openai_solution_output_path": "artifacts/openai-solution.json",
  "write_solution_artifacts_in_ci": false,
  "mock_llm_analysis_path": "fixtures/llm/analysis.json",
  "mock_llm_edit_path": "fixtures/llm/edit.json",
  "mock_sonar_issues_path": "fixtures/sonar/issues.json",
  "max_retry_count": 1,
  "supported_severities": ["LOW"],
  "supported_issue_types": ["CODE_SMELL", "BUG", "VULNERABILITY"],
  "supported_rules": ["python:S1125"],
  "validation_commands": [
    "uv run lint-imports",
    "uv run pytest",
    "uv run mypy src",
    "uv run ruff check .",
    "uv run ruff format --check ."
  ],
  "analysis": {
    "context_lines_before": 40,
    "context_lines_after": 40,
    "max_file_bytes": 200000
  },
  "approval": {
    "required": true
  },
  "review": {
    "max_changed_files": 5,
    "max_findings_per_review": 3,
    "max_prior_review_passes": 2,
    "max_context_lines_before": 30,
    "max_context_lines_after": 30,
    "publish_no_findings_note": false,
    "supported_paths": ["src/", "app/"],
    "ignored_paths": ["src/generated/"],
    "skip_draft_merge_requests": true,
    "max_review_feedback_retries": 1
  },
  "gitlab": {
    "target_branch": "main",
    "labels": ["ai-sonar-bot", "sonarqube"]
  },
  "state": {
    "path": ".ai-sonar-bot-state.json"
  }
}
